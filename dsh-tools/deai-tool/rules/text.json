{
  "$schema": "./rules.schema.json",
  "version": 1,
  "layer": "text",
  "note": "只报机械可复现的标记。报告干净不等于写得好，有问题也不等于写得差。",
  "rules": [
    {
      "id": "TXT-001",
      "title": "模板引导词堆叠",
      "title_en": "Stacked transition words",
      "object": "md-block",
      "scope": "paragraph",
      "severity": "warn",
      "defaultOn": true,
      "source": "AGENTS§4",
      "derived": false,
      "predicate": {
        "type": "first_word_stack",
        "words": ["首先", "其次", "再次", "再者", "最后", "此外"],
        "perParagraphMin": 2,
        "documentMin": 3
      },
      "exempt": ["code_block", "inline_code", "blockquote", "frontmatter"],
      "fix": "删掉引导词，让段落靠内容衔接。真需要次序时用数字或小标题，不用「首先/其次」。",
      "fix_en": "Drop the transition word. Use numbers or headings when order actually matters.",
      "autofix": null
    },
    {
      "id": "TXT-002",
      "title": "空话词密度",
      "title_en": "Buzzword density",
      "object": "md-block",
      "scope": "paragraph",
      "severity": "warn",
      "defaultOn": true,
      "source": "AGENTS§4",
      "derived": false,
      "predicate": {
        "type": "lexicon_density",
        "words": ["赋能", "闭环", "抓手", "助力", "全方位", "深度融合", "值得注意的是", "总的来说", "综上所述", "在当今", "数字化时代", "让我们一起"],
        "perParagraphMin": 2,
        "perChars": 300,
        "densityMin": 1
      },
      "exempt": ["code_block", "inline_code", "blockquote", "frontmatter"],
      "fix": "换成动词加对象：「赋能业务」→「把三个接口合成一个」。说不出具体动作的词就删。",
      "fix_en": "Replace with a verb and an object. If you cannot name the action, delete the word.",
      "autofix": null
    },
    {
      "id": "TXT-003",
      "title": "连续段首同构",
      "title_en": "Consecutive paragraphs with the same opening",
      "object": "md-block",
      "scope": "document",
      "severity": "warn",
      "defaultOn": false,
      "source": "AGENTS§4",
      "derived": true,
      "predicate": { "type": "paragraph_head_same", "consecutive": 3, "prefixChars": 2 },
      "exempt": ["code_block", "list", "table", "blockquote"],
      "fix": "换主语或换动作。三段都用同两个字起头，读起来是模板，不是人在说话。",
      "fix_en": "Change the subject or the action in at least one paragraph.",
      "autofix": null
    },
    {
      "id": "TXT-004",
      "title": "段长等齐",
      "title_en": "Uniform paragraph lengths",
      "object": "md-block",
      "scope": "document",
      "severity": "info",
      "defaultOn": false,
      "source": "AGENTS§4",
      "derived": true,
      "predicate": { "type": "paragraph_length_uniform", "consecutive": 4, "minChars": 120, "spreadRatio": 0.15 },
      "exempt": ["list", "table", "blockquote"],
      "fix": "技术文档本来就该齐整，只有连着四段长度误差不到 15% 才提示。要么长短交错，要么承认这是清单体。",
      "fix_en": "Four paragraphs within 15% of each other. Vary length, or admit it is a list in prose.",
      "autofix": null
    },
    {
      "id": "TXT-005",
      "title": "结尾复述开头",
      "title_en": "Ending restates the opening",
      "object": "md-block",
      "scope": "document",
      "severity": "warn",
      "defaultOn": true,
      "source": "AGENTS§4",
      "derived": true,
      "predicate": { "type": "ending_restates_opening", "ngram": 3, "jaccard": 0.35, "requireWords": ["综上", "总之", "总的来说"] },
      "exempt": ["code_block", "blockquote"],
      "fix": "结尾别回头抄一遍开头。给下一个动作、一个未解决的点，或者干脆删掉最后一段。",
      "fix_en": "Do not summarise the opening. End on the next action or an open question.",
      "autofix": null
    },
    {
      "id": "TXT-006",
      "title": "小标题过密",
      "title_en": "Heading density",
      "object": "md-block",
      "scope": "document",
      "severity": "info",
      "defaultOn": false,
      "source": "AGENTS§4",
      "derived": true,
      "predicate": { "type": "heading_density", "perChars": 150 },
      "exempt": ["code_block"],
      "fix": "每 150 字一个标题，是把文章拆成了目录。合并成块，让正文自己承担结构。",
      "fix_en": "One heading per 150 characters turns prose into a table of contents.",
      "autofix": null
    },
    {
      "id": "TXT-007",
      "title": "数字无来源",
      "title_en": "Number without a source",
      "object": "md-block",
      "scope": "paragraph",
      "severity": "warn",
      "defaultOn": true,
      "source": "AGENTS§4 + humanizer 13.1.9",
      "derived": false,
      "predicate": {
        "type": "number_without_source",
        "numberPattern": "\\d+(?:\\.\\d+)?\\s*(?:%|％|倍|万元|亿元|亿美元)",
        "sourceMarkers": ["（", "(", "据", "来源", "实测", "测得", "数据显示", "http", "[^", "GB/T", "样本"]
      },
      "exempt": ["code_block", "inline_code", "table", "frontmatter"],
      "fix": "数字后面补出处：什么时候、多少组、谁测的。补不出出处就删掉这个数字。",
      "fix_en": "Attach a source, or delete the number. 13.1.9 forbids invented figures; no source means no figure.",
      "autofix": null
    },
    {
      "id": "TXT-008",
      "title": "绝对化断言",
      "title_en": "Absolute claims",
      "object": "md-block",
      "scope": "paragraph",
      "severity": "warn",
      "defaultOn": true,
      "source": "AGENTS§4",
      "derived": true,
      "predicate": { "type": "absolute_claim", "words": ["唯一", "最好", "最强", "完美", "永久", "100%"] },
      "exempt": ["code_block", "inline_code", "blockquote", "table"],
      "fix": "给条件：「在 20 MB 以内的会话里最快」比「最强」可信。说不出条件就删掉形容词。",
      "fix_en": "Add the condition, or drop the adjective.",
      "autofix": null
    },
    {
      "id": "TXT-009",
      "title": "套话句式",
      "title_en": "Stock sentence patterns",
      "object": "md-block",
      "scope": "sentence",
      "severity": "warn",
      "defaultOn": true,
      "source": "AGENTS§4",
      "derived": false,
      "predicate": {
        "type": "slogan_pattern",
        "patterns": ["不仅[^。；;]{0,24}而且[^。；;]{0,24}更", "从[^。；;]{1,14}到[^。；;]{1,14}再到"]
      },
      "exempt": ["code_block", "inline_code", "blockquote"],
      "fix": "三个排比换成三个具体差异：快多少、贵多少、坏在哪。",
      "fix_en": "Replace the three-part escalation with three concrete differences.",
      "autofix": null
    },
    {
      "id": "TXT-010",
      "title": "emoji 与感叹号",
      "title_en": "Emoji and repeated exclamation marks",
      "object": "md-block",
      "scope": "paragraph",
      "severity": "warn",
      "defaultOn": true,
      "source": "AGENTS§4",
      "derived": false,
      "predicate": { "type": "emoji_or_bang", "emojiMin": 1, "bangMin": 3 },
      "exempt": ["code_block", "inline_code", "table", "frontmatter"],
      "fix": "正文里的 emoji 删掉（可以有 --fix）；连续感叹号改成句号。",
      "fix_en": "Drop emoji from body text; turn repeated bangs into periods.",
      "autofix": "safe"
    }
  ]
}
