{
  "version": 1,
  "layer": "ui",
  "note": "只报机械可判定的界面 slop。合法用法很多，所以每条规则都必须先有正例，否则不进这里。",
  "rules": [
    {
      "id": "UI-001",
      "title": "紫蓝渐变",
      "title_en": "Purple/blue gradient",
      "object": "css",
      "severity": "warn",
      "defaultOn": true,
      "source": "unslop signs §Surfaces and color",
      "predicate": {
        "type": "gradient_hue",
        "hueMin": 190,
        "hueMax": 320,
        "minSaturation": 0.35,
        "minStops": 2
      },
      "fix": "渐变本身没错，紫到蓝的搭配是模板色。换成同色相的两个明度，或者干脆用一块纯色 + 一条分隔线。",
      "fix_en": "Keep the gradient if it carries meaning; drop the purple-to-blue pair.",
      "autofix": null
    },
    {
      "id": "UI-002",
      "title": "渐变文字",
      "title_en": "Gradient text",
      "object": "css",
      "severity": "error",
      "defaultOn": true,
      "source": "unslop signs §Type + AGENTS§4",
      "predicate": {
        "type": "gradient_text"
      },
      "fix": "background-clip:text 加渐变，是最容易被认出来的 AI 版式。改回实色，靠字号和字重建立层次。",
      "fix_en": "Drop background-clip:text. Use size and weight for hierarchy.",
      "autofix": null
    },
    {
      "id": "UI-003",
      "title": "内容表面玻璃拟态",
      "title_en": "Glassmorphism on content surfaces",
      "object": "css",
      "severity": "warn",
      "defaultOn": true,
      "source": "unslop signs §Surfaces and color（2026-11-13 修订：只禁内容表面）",
      "predicate": {
        "type": "backdrop_blur",
        "allowSelectors": [
          "(^|,|\\\\s)(header|nav|dialog|\\\\.modal|\\\\.overlay|\\\\.backdrop|\\\\.sheet|\\\\.drawer|\\\\.scrim)(\\\\s|\\$|,|\\\\.|#|:)"
        ],
        "allowPosition": [
          "fixed",
          "sticky"
        ]
      },
      "fix": "模糊留给固定导航和全屏遮罩。卡片、面板、代码块这些内容表面用半透明底色就够，别再糊一层 blur——背后的内容本来就该看得清。",
      "fix_en": "Keep blur for fixed navigation and full-screen overlays. Content surfaces use a translucent fill; the text behind them should stay readable.",
      "autofix": null
    },
    {
      "id": "UI-004",
      "title": "发光阴影",
      "title_en": "Glowing shadow",
      "object": "css",
      "severity": "warn",
      "defaultOn": true,
      "source": "unslop signs §Surfaces and color",
      "predicate": {
        "type": "shadow_glow",
        "minBlurPx": 24,
        "minSaturation": 0.35
      },
      "fix": "彩色大模糊阴影是靠发光制造重点。重点应该来自位置和对比，而不是光。",
      "fix_en": "Get emphasis from position and contrast, not from a coloured glow.",
      "autofix": null
    },
    {
      "id": "UI-005",
      "title": "emoji 当图标",
      "title_en": "Emoji used as icon",
      "object": "html",
      "severity": "warn",
      "defaultOn": true,
      "source": "unslop signs §Icons + AGENTS§4",
      "predicate": {
        "type": "emoji_in_control"
      },
      "fix": "按钮和导航里的 emoji 换掉：要么留文字，要么用一条 inline SVG。emoji 在不同系统里长得不一样。",
      "fix_en": "Replace with text or an inline SVG. Emoji render differently per platform.",
      "autofix": "safe"
    },
    {
      "id": "UI-006",
      "title": "间距不在 4px 栅格",
      "title_en": "Spacing off the 4px grid",
      "object": "css",
      "severity": "info",
      "defaultOn": true,
      "source": "unslop signs §Spacing",
      "predicate": {
        "type": "magic_spacing",
        "grid": 4,
        "props": [
          "padding",
          "margin",
          "gap",
          "row-gap",
          "column-gap",
          "padding-top",
          "padding-bottom",
          "padding-left",
          "padding-right",
          "margin-top",
          "margin-bottom",
          "margin-left",
          "margin-right"
        ]
      },
      "fix": "间距值取 4 的倍数（0 和 1px 边框除外）。差 2px 肉眼看不出，但缩放和栅格对齐会出问题。",
      "fix_en": "Round spacing to multiples of 4.",
      "autofix": "safe"
    },
    {
      "id": "UI-007",
      "title": "假数据与假徽标",
      "title_en": "Placeholder data and fake badges",
      "object": "html",
      "severity": "warn",
      "defaultOn": true,
      "source": "unslop signs §Copy",
      "predicate": {
        "type": "fake_data",
        "patterns": [
          "Lorem ipsum",
          "\\$[0-9]{1,3}(,[0-9]{3})+",
          "[0-9]{1,3}(,[0-9]{3})+\\+\\s*(teams|users|customers|公司|团队)",
          "\\[X\\]",
          "New ✨",
          "Coming soon ✨"
        ]
      },
      "fix": "假价格、假用户数、Lorem 占位都会在交付时留下。换成真实数据，或者删掉这一块。",
      "fix_en": "Replace with real data or remove the block.",
      "autofix": null
    },
    {
      "id": "UI-008",
      "title": "首屏三按钮模板",
      "title_en": "Hero with three buttons",
      "object": "html",
      "severity": "info",
      "defaultOn": false,
      "source": "unslop signs §Landing pages and heroes",
      "predicate": {
        "type": "hero_three_cta",
        "minCtas": 3,
        "withinFirstH2": true
      },
      "fix": "居中大标题 + 副标题 + 三个按钮是落地页模板。留一个主操作，第二个降级成文字链接。",
      "fix_en": "One primary action; demote the rest to text links.",
      "autofix": null
    }
  ]
}
