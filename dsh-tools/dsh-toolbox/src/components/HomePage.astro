---
import GuidesBlock from './GuidesBlock.astro';
import { TOOLS, COPY } from '../lib/content.mjs';
import { iconFor } from '../lib/icons.mjs';
const { lang } = Astro.props;
const t = COPY[lang].home;
const extra = COPY[lang].homeExtra;
const prefix = lang === 'zh' ? '/zh/' : '/';
const toolHref = (slug) => (slug === 'sync-hub' ? `${prefix}sync-hub/` : `${prefix}tools/${slug}/`);
---
<h1>{t.h1}</h1>
<p class="lede">{t.lede}</p>
<p class="kit-strip"><a href={`${prefix}tools/deai-kit/`}>{COPY[lang].kitStrip} →</a></p>

<h2 id="tools">{t.toolsH}</h2>
<div class="grid">
  {TOOLS.map((tool) => {
    const detail = extra.outcomes[tool.slug];
    const card = (
      <a class="card" href={toolHref(tool.slug)}>
        <span class="card-top">
          <span class="card-icon" set:html={iconFor(tool.slug)} />
          <span class="status-badge">{tool.status === 'beta' ? (lang === 'zh' ? '内测' : 'beta') : (lang === 'zh' ? '稳定' : 'stable')}</span>
        </span>
        <h3>{tool.name}</h3>
        <p class="card-meta">{tool.meta[lang]}</p>
        <p class="card-outcome">{detail?.outcome}</p>
        <span class="card-more">{detail?.demoLabel ?? extra.demoCta}</span>
      </a>
    );
    return card;
  })}
</div>
<p class="note">{t.toolsNote}</p>
<p class="card-extra">
  <a href={`${prefix}tools/session-purge/#one-click`}>{lang === 'zh' ? '想要一键版？' : 'Want a one-click version?'}</a>
</p>

<GuidesBlock lang={lang} />

<h2>{t.whyH}</h2>
{t.why.map((item) => (
  <div>
    <h3>{item.h}</h3>
    <p>{item.p}</p>
  </div>
))}

<h2>{t.faqH}</h2>
{t.faq.map((item) => (
  <details>
    <summary>{item.q}</summary>
    <p>{item.a}</p>
  </details>
))}

<p style="margin-top:28px">
  <a class="cta" href={`${prefix}sync-hub/`}>{t.cta} →</a>
</p>
