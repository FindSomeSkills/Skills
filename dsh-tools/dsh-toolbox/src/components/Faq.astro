---
// 通用 FAQ 区块：内容来自各页 copy 的 faq 数组，同时用于可见内容与 FAQPage 结构化数据。
import { inline } from '../lib/inline.mjs';
const { items, heading = 'Common questions' } = Astro.props;
---
{Array.isArray(items) && items.length > 0 && (
  <section class="faq-block">
    <h2>{heading}</h2>
    {items.map((item) => (
      <details>
        <summary set:html={inline(item.q)} />
        <p set:html={inline(item.a)} />
      </details>
    ))}
  </section>
)}
