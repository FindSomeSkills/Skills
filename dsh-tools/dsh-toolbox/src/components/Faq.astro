---
// Shared FAQ block: renders the page's faq array and feeds the same data to FAQPage JSON-LD.
// Accepts both { q, a } objects and [q, a] tuples, because two content modules use tuples.
import { inline } from '../lib/inline.mjs';

const { items, heading = 'Common questions' } = Astro.props;
const list = (items ?? []).map((item) =>
  Array.isArray(item) ? { q: item[0], a: item[1] } : item,
);
---
{list.length > 0 && (
  <section class="faq-block">
    <h2>{heading}</h2>
    {list.map((item) => (
      <details>
        <summary set:html={inline(item.q)} />
        <p set:html={inline(item.a)} />
      </details>
    ))}
  </section>
)}
