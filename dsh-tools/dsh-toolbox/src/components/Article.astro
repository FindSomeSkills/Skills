---
// Guide / 对比页 / 插件页的统一渲染。
import Faq from './Faq.astro';
import { linkFor } from '../lib/links.mjs';
import { inline } from '../lib/inline.mjs';

const { data, lang, plugins = [], groups = [], siblings = [] } = Astro.props;
const t = data;
const related = (t.related ?? []).map((id) => ({ id, ...linkFor(id, lang) }));
const pluginBase = linkFor('plugins', lang).href;

// 冲突页的分组：items 带 a/b/symptom/keep/why
const isPairGroup = (g) => Array.isArray(g.items) && g.items.length > 0 && 'symptom' in g.items[0];
const isPluginGroup = (g) => Array.isArray(g.items) && g.items.length > 0 && 'pkg' in g.items[0];
const allGroups = groups.length > 0 ? groups : (t.groups ?? []);
---
<h1>{t.h1}</h1>

<p class="answer" set:html={inline(t.cite)} />

{(t.lead ?? []).map((p) => <p class="lede" set:html={inline(p)} />)}

{t.links && (
  <ul class="link-list">
    {t.links.map((l) => <li><a href={l.href}>{l.label}</a> — {l.note}</li>)}
  </ul>
)}

{t.table && (
  <div class="table-scroll">
    <table>
      <thead>
        <tr>{t.table.head.map((h) => <th>{h}</th>)}</tr>
      </thead>
      <tbody>
        {t.table.rows.map((row) => (
          <tr>{row.map((cell) => <td set:html={inline(cell)} />)}</tr>
        ))}
      </tbody>
    </table>
  </div>
)}

{(t.sections ?? []).map((s) => (
  <section>
    <h2 set:html={inline(s.h)} />
    {(s.p ?? []).map((p) => <p set:html={inline(p)} />)}
    {s.code && <pre><code>{s.code}</code></pre>}
    {s.links && (<ul class="link-list">{s.links.map((l) => <li><a href={lang === 'zh' ? (l.zhHref ?? l.href) : l.href}>{l.pkg}</a></li>)}</ul>)}
  </section>
))}

{plugins.length > 0 && (
  <section>
    <h2>{lang === 'zh' ? '官方包' : 'Official packages'}</h2>
    {[
      { kind: 'library', en: 'Shared libraries', zh: '共享库' },
      { kind: 'other', en: 'Profile packages', zh: 'Profile 包' },
    ].map((group) => {
      const list = plugins.filter((pl) => (group.kind === 'library' ? pl.kind === 'library' : pl.kind !== 'library'));
      if (list.length === 0) return null;
      return (
        <div>
          <h3>{lang === 'zh' ? group.zh : group.en} ({list.length})</h3>
          <ul class="link-list">
            {list.map((pl) => (
              <li>
                <a href={pluginBase + pl.slug + '/'}>{pl.pkg}</a> — {lang === 'zh' ? pl.zh : pl.en} <span class="pkg-version">{pl.version}</span>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </section>
)}

{allGroups.map((g) => (
  <section>
    <h2 set:html={inline(g.h ?? (lang === 'zh' ? g.zh : g.en))} />
    {isPairGroup(g) ? (
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>{lang === 'zh' ? '包 A' : 'Package A'}</th>
              <th>{lang === 'zh' ? '包 B' : 'Package B'}</th>
              <th>{lang === 'zh' ? '一起装会看到什么' : 'What you see'}</th>
              <th>{lang === 'zh' ? '留哪个' : 'Keep'}</th>
              <th>{lang === 'zh' ? '为什么留它' : 'Why keep it'}</th>
              <th>{lang === 'zh' ? '为什么不能共存' : 'Why they cannot coexist'}</th>
            </tr>
          </thead>
          <tbody>
            {g.items.map((it) => (
              <tr>
                <td>{it.aHref ? <a href={it.aHref}><code>{it.a}</code></a> : <code>{it.a}</code>}</td>
                <td>{it.bHref ? <a href={it.bHref}><code>{it.b}</code></a> : <code>{it.b}</code>}</td>
                <td set:html={inline(lang === 'zh' ? (it.symptomZh || it.symptom) : it.symptom)} />
                <td><code>{it.keep}</code></td>
                <td set:html={inline(it.why)} />
                <td set:html={inline(lang === 'zh' ? (it.clashZh || '') : (it.clash || ''))} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : isPluginGroup(g) ? (
      <ul class="link-list">
        {g.items.map((pl) => (
          <li>
            <a href={`${pluginBase}${pl.owner}/${pl.slug}/`}>{pl.pkg}</a> — {lang === 'zh' ? pl.zh.solves : pl.en.solves} <span class="pkg-version">{pl.version}</span>
          </li>
        ))}
      </ul>
    ) : null}
  </section>
))}

<Faq items={t.faq ?? []} heading={lang === 'zh' ? '常见问题' : 'Common questions'} />

{siblings.length > 0 && (
  <section class="related">
    <h2>{lang === 'zh' ? '这几个报错' : 'The other four'}</h2>
    <ul class="link-list">
      {siblings.map((x) => <li><a href={x.href}>{x.label}</a></li>)}
    </ul>
  </section>
)}

{t.footer && (
  <section class="related">
    <h2>{lang === 'zh' ? '相关入口' : 'Where to go next'}</h2>
    <ul class="link-list">
      <li><a href={lang === 'zh' ? t.footer.allZhHref : t.footer.allHref}>{lang === 'zh' ? t.footer.allZhLabel : t.footer.allLabel}</a></li>
      {t.footer.conflict && (
        <li><a href={lang === 'zh' ? t.footer.conflict.zhHref : t.footer.conflict.href}>{lang === 'zh' ? t.footer.conflict.zhLabel : t.footer.conflict.label}</a></li>
      )}
      {t.footer.peers.length > 0 && (
        <li>
          {lang === 'zh' ? '它 peer 的官方包：' : 'Official packages it peers: '}
          {t.footer.peers.map((p, i) => (
            <span>{i > 0 && ', '}<a href={lang === 'zh' ? (p.zhHref || p.href) : p.href}>{p.pkg}</a></span>
          ))}
        </li>
      )}
      {t.footer.peersUnlinked?.length > 0 && (
        <li>
          {(() => {
            const n = t.footer.peersUnlinked.length;
            const names = t.footer.peersUnlinked.join(lang === 'zh' ? '、' : ', ');
            if (lang === 'zh') return `另外 peer 了 ${names}——这些包在本站目录里没有页面，故不给链接。`;
            if (n === 1) return `It also peers ${names} — that package has no page in this directory, so it is not linked.`;
            if (n === 2) return `It also peers ${names} — neither has a page in this directory, so neither is linked.`;
            return `It also peers ${names} — none of these packages has a page in this directory, so none are linked.`;
          })()}
        </li>
      )}
      {t.footer.tool && (
        <li>
          <a href={lang === 'zh' ? t.footer.tool.zhHref : t.footer.tool.href}>
            {lang === 'zh' ? t.footer.tool.zhLabel : t.footer.tool.label}
          </a>
        </li>
      )}
    </ul>
  </section>
)}

{related.length > 0 && (
  <section class="related">
    <h2>{lang === 'zh' ? '相关' : 'Related'}</h2>
    <ul class="link-list">
      {related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}
    </ul>
  </section>
)}
