---
import Base from '../layouts/Base.astro';
import HomePage from '../components/HomePage.astro';
import SyncHubPage from '../components/SyncHubPage.astro';
import ZstdInspector from '../components/ZstdInspector.astro';
import ContextBudget from '../components/ContextBudget.astro';
import IndexDoctor from '../components/IndexDoctor.astro';
import SkillAudit from '../components/SkillAudit.astro';
import ReferencePage from '../components/ReferencePage.astro';
import ComparePage from '../components/ComparePage.astro';
import Related from '../components/Related.astro';
import Faq from '../components/Faq.astro';
import Article from '../components/Article.astro';
import { FAQ_EXTRA } from '../lib/faq.mjs';
import { GUIDES } from '../lib/content-guides.mjs';
import { VERSUS } from '../lib/content-versus.mjs';
import { PLUGIN_INDEX, PLUGINS, pluginPage } from '../lib/content-plugins.mjs';
import { communityPage, communityByGroup } from '../lib/content-community.mjs';
import DeaiKit from '../components/DeaiKit.astro';
import SessionPurge from '../components/SessionPurge.astro';
import { PURGE, ERRORS } from '../lib/content-purge-errors.mjs';
import { ERROR_PAGES } from '../lib/content-error-pages.mjs';
import { CONFLICTS_PAGE } from '../lib/content-conflicts-page.mjs';
import { COMMUNITY } from '../lib/content-community.mjs';
import { CLASH } from '../lib/conflict-clash.mjs';
import { LIBRARY } from '../lib/library-pages.mjs';
import { SYMPTOM_OVERRIDE } from '../lib/conflict-symptom.mjs';
import { PURGE_SECTIONS } from '../lib/content-purge-sections.mjs';
import { COPY, SITE, pageList } from '../lib/content.mjs';
import { updatedFor } from '../lib/updated.mjs';

export function getStaticPaths() {
  return pageList().map((p) => ({
    params: { slug: p.slug === '' ? undefined : p.slug },
    props: { lang: p.lang, page: p.page, slug: p.slug, noindex: p.noindex ?? false },
  }));
}

const { lang, page, slug, noindex = false } = Astro.props;
const copy = COPY[lang];
const baseSlug = lang === 'zh' ? slug.replace(/^zh\/?/, '') : slug;
const pluginPath = baseSlug.startsWith('plugins/') ? baseSlug.slice('plugins/'.length) : '';
const article =
  GUIDES[baseSlug]?.[lang] ??
  VERSUS[baseSlug]?.[lang] ??
  (baseSlug === 'guides/errors' ? ERRORS[lang] : null) ??
  (ERROR_PAGES[baseSlug]?.[lang] ?? null) ??
  (baseSlug === 'plugins/conflicts' ? CONFLICTS_PAGE[lang] : null) ??
  (page === 'purge' ? PURGE[lang] : null) ??
  (baseSlug === 'plugins' ? PLUGIN_INDEX[lang] : null) ??
  (pluginPath.includes('/') ? communityPage(pluginPath)?.[lang] : null) ??
  (pluginPath ? pluginPage(pluginPath, lang) : null);
const t = article ?? copy[page];
const ERROR_SIBLINGS = lang === 'zh'
  ? [
      { label: 'deepseek messages transport failed', href: '/zh/guides/errors/messages-transport-failed/' },
      { label: 'zsh: command not found: corepack', href: '/zh/guides/errors/corepack-command-not-found/' },
      { label: 'Plugin X is incompatible with dsh Y', href: '/zh/guides/errors/plugin-incompatible/' },
      { label: 'EBADENGINE', href: '/zh/guides/errors/ebadengine/' },
      { label: '--host 拒绝 0.0.0.0', href: '/zh/guides/errors/host-wildcard-rejected/' },
      { label: '回到报错总览', href: '/zh/guides/errors/' },
    ]
  : [
      { label: 'deepseek messages transport failed', href: '/guides/errors/messages-transport-failed/' },
      { label: 'zsh: command not found: corepack', href: '/guides/errors/corepack-command-not-found/' },
      { label: 'Plugin X is incompatible with dsh Y', href: '/guides/errors/plugin-incompatible/' },
      { label: 'EBADENGINE', href: '/guides/errors/ebadengine/' },
      { label: '--host refuses 0.0.0.0', href: '/guides/errors/host-wildcard-rejected/' },
      { label: 'Back to the error overview', href: '/guides/errors/' },
    ];
const errorSiblings = baseSlug.startsWith('guides/errors/')
  ? ERROR_SIBLINGS.filter((x) => x.href !== `/${lang === 'zh' ? 'zh/' : ''}${baseSlug}/`)
  : [];


// 冲突页：包名 → 详情页链接（社区包按 owner/slug，官方包按短名）；中文页加 /zh 前缀
const langPrefix = lang === 'zh' ? '/zh' : '';
const PKG_TO_HREF = new Map(COMMUNITY.map((x) => [x.pkg, `${langPrefix}/plugins/${x.owner}/${x.slug}/`]));
const OFFICIAL_HREF = (pkg) => `${langPrefix}/plugins/` + pkg.replace('@deepseek-ai/', '') + '/';
const withHrefs = (groups) => (groups ?? []).map((g) => ({
  ...g,
  items: (g.items ?? []).map((it) => ({
    ...it,
    aHref: PKG_TO_HREF.get(it.a) ?? OFFICIAL_HREF(it.a),
    bHref: PKG_TO_HREF.get(it.b) ?? OFFICIAL_HREF(it.b),
    clash: (CLASH[[it.a, it.b].join('|')] ?? CLASH[[it.b, it.a].join('|')])?.en ?? '',
    clashZh: (CLASH[[it.a, it.b].join('|')] ?? CLASH[[it.b, it.a].join('|')])?.zh ?? '',
    symptom: (SYMPTOM_OVERRIDE[[it.a, it.b].join('|')] ?? SYMPTOM_OVERRIDE[[it.b, it.a].join('|')])?.en ?? it.symptom,
    symptomZh: (SYMPTOM_OVERRIDE[[it.a, it.b].join('|')] ?? SYMPTOM_OVERRIDE[[it.b, it.a].join('|')])?.zh ?? it.symptom,
  })),
}));
const conflictGroups = baseSlug === 'plugins/conflicts' && CONFLICTS_PAGE[lang]
  ? withHrefs(CONFLICTS_PAGE[lang].groups)
  : [];

const base = Astro.site?.href?.replace(/\/$/, '') ?? 'http://127.0.0.1:4321';

const rawFaq = Array.isArray(t.faq) ? t.faq : (FAQ_EXTRA[lang]?.[page] ?? []);
const faqItems = rawFaq.map((item) => (Array.isArray(item) ? { q: item[0], a: item[1] } : item));

const faqLd = Array.isArray(faqItems) && faqItems.length > 0
  ? {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: copy.nav.home, item: `${base}/${lang === 'zh' ? 'zh/' : ''}` },
    ...(slug.includes('/') || page !== 'home'
      ? [{ '@type': 'ListItem', position: 2, name: t.h1 ?? SITE.name, item: `${base}/${slug}/` }]
      : []),
  ],
};

// 页面类型分流：工具页 = WebApplication；插件页/库页 = SoftwareApplication；
// 指南/对比/报错/冲突 = TechArticle；插件目录 = CollectionPage；首页 = 不加实体节点（Base 里有 WebSite）。
const isToolPage = baseSlug === 'sync-hub' || baseSlug.startsWith('tools/');
const isPluginDetail = baseSlug.startsWith('plugins/') && baseSlug !== 'plugins' && baseSlug !== 'plugins/conflicts';
const isPluginsIndex = baseSlug === 'plugins';
const isLibrary = baseSlug.startsWith('plugins/') && Boolean(LIBRARY[baseSlug.slice('plugins/'.length)]);
const isArticlePage = baseSlug.startsWith('guides/') || baseSlug.startsWith('compare/') || baseSlug === 'plugins/conflicts' || baseSlug === 'reference';
const pageUrl = `${base}/${slug ? `${slug}/` : ''}`;

const software = isToolPage
  ? {
      '@type': 'WebApplication',
      name: page === 'syncHub' ? 'DSH Sync Hub' : t.h1,
      url: pageUrl,
      applicationCategory: 'DeveloperApplication',
      dateModified: updatedFor(baseSlug),
      datePublished: updatedFor(baseSlug),
      operatingSystem: 'Windows, macOS, Linux, Android',
      description: t.desc,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      isAccessibleForFree: true,
      inLanguage: lang === 'zh' ? 'zh-Hans' : 'en',
      ...(page === 'syncHub'
        ? { softwareVersion: '0.1.0', license: 'https://opensource.org/licenses/MIT' }
        : { browserRequirements: 'Requires JavaScript. Runs entirely client-side.' }),
    }
  : isLibrary
    ? {
        '@type': 'SoftwareSourceCode',
        name: t.h1,
        url: pageUrl,
        description: t.desc,
        inLanguage: lang === 'zh' ? 'zh-Hans' : 'en',
        dateModified: updatedFor(baseSlug),
        datePublished: updatedFor(baseSlug),
      }
    : isPluginDetail
    ? {
        '@type': 'SoftwareApplication',
        name: t.h1,
        url: pageUrl,
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Windows, macOS, Linux',
        description: t.desc,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        isAccessibleForFree: true,
        inLanguage: lang === 'zh' ? 'zh-Hans' : 'en',
        dateModified: updatedFor(baseSlug),
        datePublished: updatedFor(baseSlug),
      }
    : null;

const collection = isPluginsIndex
  ? {
      '@type': 'CollectionPage',
      name: t.h1,
      url: pageUrl,
      description: t.desc,
      inLanguage: lang === 'zh' ? 'zh-Hans' : 'en',
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: PLUGINS.length + COMMUNITY.length,
        itemListElement: [
          ...PLUGINS.map((p, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: p.pkg,
            url: `${base}${lang === 'zh' ? '/zh' : ''}/plugins/${p.slug}/`,
          })),
          ...COMMUNITY.map((c, i) => ({
            '@type': 'ListItem',
            position: PLUGINS.length + i + 1,
            name: c.pkg,
            url: `${base}${lang === 'zh' ? '/zh' : ''}/plugins/${c.owner}/${c.slug}/`,
          })),
        ],
      },
    }
  : null;

const howTo = page === 'syncHub' && Array.isArray(t.steps)
  ? {
      '@type': 'HowTo',
      name: lang === 'zh' ? '如何跨设备同步 DSH 会话' : 'How to sync DSH sessions across machines',
      description: t.desc,
      totalTime: 'PT10M',
      tool: [{ '@type': 'HowToTool', name: 'DSH Sync Hub' }],
      step: t.steps.map((step, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: step.h,
        text: step.p,
        url: `${base}/${slug}/#step-${i + 1}`,
      })),
    }
  : null;

const techArticle = isArticlePage
  ? {
      '@type': 'TechArticle',
      headline: t.h1,
      description: t.desc,
      datePublished: '2026-11-13',
      dateModified: updatedFor(baseSlug),
      inLanguage: lang === 'zh' ? 'zh-Hans' : 'en',
      author: { '@type': 'Organization', name: SITE.name, url: `${base}/` },
      publisher: { '@type': 'Organization', name: SITE.name, url: `${base}/` },
      about: { '@type': 'SoftwareApplication', name: 'DeepSeek Harness' },
      mainEntityOfPage: pageUrl,
    }
  : null;

const jsonLd = [software, collection, faqLd, breadcrumb, howTo, techArticle].filter(Boolean);

// page → 内容 id，用于内链与 Related
const CONTENT_ID = {
  home: null,
  syncHub: 'sync-hub',
  zstd: 'zstd-frame-inspector',
  budget: 'context-budget',
  doctor: 'session-index-doctor',
  skills: 'skill-load-audit',
  reference: 'reference',
  compare: 'compare',
};
const contentId = CONTENT_ID[page];
const pageTitle = t.title ?? `${t.h1} — ${SITE.name}`;
const pageDesc = t.desc ?? `${t.lede}`.slice(0, 155);
---
<Base title={pageTitle} description={pageDesc} lang={lang} slug={slug} jsonLd={jsonLd} robots={article?.noindex || noindex ? 'noindex,follow' : 'index,follow'}>
  {page === 'home' && <HomePage lang={lang} />}
  {page === 'syncHub' && <SyncHubPage lang={lang} />}
  {page === 'zstd' && <ZstdInspector lang={lang} />}
  {page === 'budget' && <ContextBudget lang={lang} />}
  {page === 'doctor' && <IndexDoctor lang={lang} />}
  {page === 'skills' && <SkillAudit lang={lang} />}
  {page === 'reference' && <ReferencePage lang={lang} />}
  {page === 'compare' && <ComparePage lang={lang} />}
  {page === 'kit' && <DeaiKit lang={lang} />}
  {page === 'purge' && <SessionPurge t={PURGE[lang]} sections={PURGE_SECTIONS[lang]} />}
  {article && page !== 'purge' && <Article data={article} siblings={errorSiblings} lang={lang} plugins={baseSlug === 'plugins' ? PLUGINS : []} groups={baseSlug === 'plugins' ? communityByGroup() : conflictGroups} />}
  {page !== 'home' && page !== 'compare' && page !== 'syncHub' && !article && faqItems.length > 0 && (
    <Faq items={faqItems} heading={lang === 'zh' ? '常见问题' : 'Common questions'} />
  )}
  {contentId && page !== 'syncHub' && <Related lang={lang} current={contentId} />}
</Base>
