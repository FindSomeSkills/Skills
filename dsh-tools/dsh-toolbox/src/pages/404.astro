---
// 404 页：静态站点里必须有实体文件，Cloudflare Pages 才会返回真正的 404 状态码。
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/content.mjs';
---
<Base
  title={`Page not found — ${SITE.name}`}
  description="That address does not exist. Start from the tool list instead."
  lang="en"
  slug="404"
  robots="noindex,follow"
>
  <h1>That page is not here</h1>
  <p class="lede">The address you opened does not exist — a typo, or something that moved.</p>
  <p><a class="cta" href="/">Back to the tool list →</a></p>

  <h2>Pages that do exist</h2>
  <ul>
    <li><a href="/plugins/">Plugin directory</a> — 83 package pages, grouped by what they solve</li>
    <li><a href="/plugins/conflicts/">Plugin conflicts</a> — 26 pairs that cannot share a profile</li>
    <li><a href="/guides/errors/">Error reference</a> — five DSH failures, one page each</li>
    <li><a href="/tools/zstd-frame-inspector/">Zstd Frame Inspector</a> — read a .zstd session file's frames</li>
    <li><a href="/tools/context-budget/">Context Budget</a> — how many turns are left before compaction</li>
    <li><a href="/tools/session-index-doctor/">Session Index Doctor</a> — sessions on disk that never reach the list</li>
    <li><a href="/tools/skill-load-audit/">Skill Load Audit</a> — which skill costs the most context</li>
    <li><a href="/tools/deai-kit/">De-AI Kit</a> — template markers in text or CSS</li>
    <li><a href="/sync-hub/">DSH Sync Hub</a> — sync sessions across machines</li>
    <li><a href="/reference/">Storage reference</a> — session formats and index fields</li>
  </ul>

  <p><a href="/zh/">中文首页</a></p>
</Base>
