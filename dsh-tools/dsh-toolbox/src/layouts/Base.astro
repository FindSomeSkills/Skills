---
import '../styles/global.css';
import '../styles/apple.css';
import '../styles/theme.css';
import { SITE, COPY, TOOLS, alternateFor } from '../lib/content.mjs';

const {
  lang = 'en',
  slug = '',
  title,
  description,
  jsonLd = [],
  robots = 'index,follow',
} = Astro.props;

const copy = COPY[lang];
const base = Astro.site?.href?.replace(/\/$/, '') ?? 'http://127.0.0.1:4321';
const canonical = `${base}/${slug ? `${slug}/` : ''}`;
const altUrl = `${base}${alternateFor(slug)}`;
const altLang = lang === 'en' ? 'zh-Hans' : 'en';
const homeHref = lang === 'en' ? '/' : '/zh/';
const langHref = lang === 'en' ? alternateFor(slug) : alternateFor(slug);
const ariaTpl = lang === 'en'
  ? 'Appearance: {cur}. Click for {next}'
  : '当前{cur}，点击切换到{next}';
const themeLabels = lang === 'en'
  ? { light: 'Light', dark: 'Dark', auto: 'System' }
  : { light: '浅色', dark: '深色', auto: '跟随系统' };
const buildDate = new Date().toISOString().slice(0, 10);
const graph = [
  {
    '@type': 'WebSite',
    dateModified: buildDate,
    name: SITE.name,
    url: `${base}/`,
    inLanguage: ['en', 'zh-Hans'],
  },
  {
    '@type': 'Organization',
    name: SITE.name,
    url: `${base}/`,
    sameAs: [SITE.repo],
  },
  ...jsonLd,
  ...(slug === '' || slug === 'zh'
    ? [
        {
          '@type': 'ItemList',
          name: lang === 'zh' ? '工具清单' : 'Tool list',
          itemListElement: TOOLS.map((t, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: t.name,
            url: `${base}${lang === 'zh' ? '/zh' : ''}/tools/${t.slug}/`,
          })),
        },
      ]
    : []),
];
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hans' : 'en'}>
  <head>
    <script is:inline>
      // Light by default. Priority: URL param, then saved choice, then light.
      (() => {
        const param = new URLSearchParams(location.search).get('theme');
        const saved = localStorage.getItem('theme');
        const pick = param || saved || 'light';
        const resolved = pick === 'auto'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : pick;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themeMode = pick;
        document.documentElement.style.colorScheme = resolved;
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'zh-Hans' : 'en'} href={canonical} />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={`${base}${slug.startsWith('zh') ? alternateFor(slug) : `/${slug ? `${slug}/` : ''}`}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${base}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${base}/og.png`} />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
  <a class="skip-link" href="#main">{lang === 'zh' ? '跳到主要内容' : 'Skip to content'}</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={homeHref}><span class="dot"></span>{SITE.name}</a>
        <nav>
          <a href={homeHref}>{copy.nav.home}</a>
          <a href={`${homeHref}#tools`}>{copy.nav.tools}</a>
      <a href={`${homeHref}guides/what-is-deepseek-harness/`}>{copy.nav.guides}</a>
          <a href={`${homeHref}tools/deai-kit/`}>{copy.nav.deai}</a>
          <a href={`${homeHref}sync-hub/`}>Sync Hub</a>
          <button type="button" class="theme-toggle" id="theme-toggle" aria-live="polite">
          </button>
          <a href={langHref} hreflang={lang === 'zh' ? 'en' : 'zh-Hans'}>{lang === 'zh' ? 'English' : 'Chinese'}</a>
        </nav>
      </div>
    </header>

    <main class="wrap" id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <p class="footer-line">{copy.footer.note}</p>
      </div>
    </footer>
    <script is:inline>
      // Header: solidify after 8px of scroll so the blur reads as material.
      const head = document.querySelector('header.site');
      const onScroll = () => head && head.classList.toggle('scrolled', window.scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Reveal on scroll: fade each block in, respecting reduced motion.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        const targets = [...document.querySelectorAll('main h2, main > p, main .grid > *, main pre, main table, .kit-strip')];
        targets.forEach((el) => el.classList.add('reveal'));
        // Take over first, hide second: only html.js-reveal makes .reveal transparent.
        document.documentElement.classList.add('js-reveal');
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }
        }, { threshold: 0.06, rootMargin: '0px 0px -40px 0px' });
        targets.forEach((el) => io.observe(el));
        // Safety net: anything still hidden after 1.2s is shown unconditionally.
        setTimeout(() => {
          targets.forEach((el) => el.classList.add('in'));
        }, 1200);
      }
    </script>
    <script is:inline define:vars={{ themeLabels, ariaTpl }}>
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const name = themeLabels;
        const order = ['light', 'dark', 'auto'];
        const say = (cur, next) => ariaTpl.replace('{cur}', cur).replace('{next}', next);
        const apply = (mode) => {
          const resolved = mode === 'auto'
            ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : mode;
          const root = document.documentElement;
          root.dataset.theme = resolved;
          root.dataset.themeMode = mode;
          root.style.colorScheme = resolved;
          const nextName = name[order[(order.indexOf(mode) + 1) % order.length]];
          btn.textContent = name[mode];
          btn.setAttribute('aria-label', say(name[mode], nextName));
          btn.title = say(name[mode], nextName);
          btn.dataset.mode = mode;
        };
        apply(document.documentElement.dataset.themeMode || 'light');
        btn.addEventListener('click', () => {
          const now = btn.dataset.mode || 'light';
          const next = order[(order.indexOf(now) + 1) % order.length];
          localStorage.setItem('theme', next);
          apply(next);
        });
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
          if ((btn.dataset.mode || 'light') === 'auto') apply('auto');
        });
      })();
    </script>
  </body>
</html>
